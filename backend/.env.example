# ---------------------------------------------------------------------------
# Plantilla de variables de entorno — ResumeTailor-AI
#
#   cp backend/.env.example backend/.env
#
# Este archivo NO contiene claves reales. `backend/.env` está en .gitignore
# y en `backend/.dockerignore`: con Docker las credenciales se inyectan en
# tiempo de ejecución (`env_file:` en compose.yaml), nunca se hornean en la
# imagen.
#
# Con Docker NO hace falta definir nada de esto en el compose: basta con
# tener backend/.env lleno.
# ---------------------------------------------------------------------------

# --- Proveedor LLM primario (opcional si usas sólo Gemini) -----------------
# Valores admitidos: openai_compatible | deepseek | minimax | kimi |
# moonshot | openrouter | groq | gemini
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Fallback Gemini -------------------------------------------------------
# Obligatorio si el primario falla o expira (y si no hay primario).
GEMINI_API_KEY=

# --- Alias alternativos (opcionales) --------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# --- Enriquecimiento con LinkedIn (opcional) -------------------------------
# Ruta recomendada: API externa (ProxyCurl o similar).
# LINKEDIN_API_URL=
# LINKEDIN_API_KEY=
# PROXYCURL_API_KEY=

# Ruta alternativa: scraping autenticado con Playwright.
# ⚠️ Violates los TOS de LinkedIn — úsalo bajo tu responsabilidad.
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=

# --- Ajustes de la app -----------------------------------------------------
# Orígenes permitidos por CORS (frontend nginx corre en el mismo origen, así
# que normalmente no hace falta tocarlo).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Límite de peticiones por minuto para los endpoints que gastan LLM.
# RATE_LIMIT_DEFAULT=5/minute
# RATELIMIT_ENABLED=1
