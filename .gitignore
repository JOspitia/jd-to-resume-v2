# Environments
.env
assets/
**/venv/
**/__pycache__/
node_modules/
dist/
dist-ssr/
build/
*.local
*.atl

# IDEs and OS
.vscode/
.idea/
.DS_Store
*.suo
*.sln
*.sw?

# Personal/Temp Files
*.pdf
!sample-pdfs/*.pdf
*.log
*.txt
!requirements.txt
!knowledge_base.txt
!README.md
!*.md

# Learning notes / personal study guides that don't belong to the project
/*PLAYWRIGHT*.md
/*FASTAPI*.md

# Output & RenderCV temp files
backend/output/
backend/rendercv_output/
backend/test_cv.*
backend/test_output.*
rendercv/
rendercv_output/

# Images — only the root, so future fixtures and frontend assets stay tracked
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.ico
# Allow frontend public assets to be committed even when they share an
# extension with the patterns above.
/!frontend/public/**

